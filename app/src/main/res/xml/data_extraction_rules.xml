<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 系統備份：只備份設定（DataStore）；音檔快取不備份 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
